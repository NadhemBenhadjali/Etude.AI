# --- Deployment Environment ---
# Options: development, production
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# --- Security (Keycloak) ---
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8083
KEYCLOAK_REALM=etudeai
KEYCLOAK_RESOURCE=etudeai-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production

# --- Database: Neo4j ---
# Use neo4j+s:// for cloud, bolt:// for local
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- Database: Qdrant ---
QDRANT_URL=https://your-cluster-url.us-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# --- Database: Postgres (Backend) ---
POSTGRES_HOST=backend-db
POSTGRES_PORT=5432
POSTGRES_DB=Etudeai
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

# --- Database: Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Full URL for Python clients
REDIS_URL=redis://redis:6379/0

# --- AI Services ---
GEMINI_API_KEY=your_google_gemini_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: Only needed if exposing locally via Ngrok
NGROK_AUTH_TOKEN=

# --- Observability ---
SENTRY_DSN=

# --- Service Communication URLs ---
AI_PIPELINE_URL=http://ai-pipeline:8000
TTS_SERVICE_URL=http://tts-service:8000