apiVersion: v1
kind: Secret
metadata:
  name: etude-ai-secrets
  namespace: etude-ai
type: Opaque
stringData:
  # Neo4j - Internal K8s service (deployed in 02-infrastructure.yaml)
  # Connection: bolt://neo4j:7687
  neo4j-password: "YOUR_NEO4J_PASSWORD"
  neo4j-user: "neo4j"

  # PostgreSQL - Internal K8s service
  postgres-password: "YOUR_POSTGRES_PASSWORD"
  postgres-user: "admin"
  postgres-db: "Etudeai"

  # Redis - Internal K8s service (no password needed)
  redis-password: ""

  # Keycloak - Internal K8s service
  keycloak-admin: "admin"
  keycloak-admin-password: "YOUR_KEYCLOAK_PASSWORD"
  keycloak-realm: "etudeai"
  keycloak-resource: "etudeai-backend"

  # LLM API - External service (Mistral/OpenRouter)
  llm-api-key: "YOUR_LLM_API_KEY"
  gemini-api-key: "YOUR_GEMINI_API_KEY"
  mistral-api-key: "YOUR_MISTRAL_API_KEY"
  llm-model: "mistral/mistral-large-latest"
  embedding-model: "mistral/mistral-embed"

  # Qdrant - Internal K8s service (API key optional, can be empty)
  # Connection: http://qdrant:6333
  qdrant-api-key: ""

  # ElevenLabs TTS - Replace with your API key
  elevenlabs-api-key: "YOUR_ELEVENLABS_API_KEY"


  # Sentry - Replace with your Sentry DSNs
  sentry-dsn: "https://YOUR_PYTHON_SENTRY_DSN@sentry.io/project"
  sentry-dsn-backend: "https://YOUR_JAVA_SENTRY_DSN@sentry.io/project"

  # Environment
  environment: "production"
  release-version: "v1.0.0"

---
# ConfigMap for non-sensitive configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: etude-ai-config
  namespace: etude-ai
data:
  # Application URLs
  AI_PIPELINE_URL: "http://ai-pipeline:8000"
  TTS_SERVICE_URL: "http://tts-service:8000"

  # Keycloak
  KEYCLOAK_REALM: "etudeai"
  KEYCLOAK_RESOURCE: "etudeai-backend"
  KEYCLOAK_PUBLIC_URL: "http://localhost:8083"
  KEYCLOAK_AUTH_SERVER_URL: "http://keycloak:8080"

  # Database hosts - Internal K8s services
  NEO4J_URI: "bolt://neo4j:7687"
  POSTGRES_HOST: "postgres"
  POSTGRES_PORT: "5432"
  REDIS_HOST: "redis"
  REDIS_PORT: "6379"
  REDIS_URL: "redis://redis:6379/0"
  QDRANT_URL: "http://qdrant:6333"

  # AI Models
  LLM_MODEL: "mistral/mistral-large-latest"
  EMBEDDING_MODEL: "mistral/mistral-embed"

  # Application Environment
  APP_ENV: "production"

  # CORS - Update with your allowed origins
  ALLOWED_ORIGINS: "http://localhost:4200,http://localhost:8081"

  # Environment
  APP_ENV: "production"

